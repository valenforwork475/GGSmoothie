{
  "redirects": [
    {
      "source": "/pos",
      "destination": "/POS-1c-standalone.html?v=v5",
      "permanent": false
    },
    {
      "source": "/sunmi",
      "destination": "/downloads/GG-POS-SUNMI-1.1.0.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(POS-1c-standalone.html|sw.js|backoffice/.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}